
# ==========================================
# SpeakSpot .gitignore
# React + TypeScript + Vite + Python + FastAPI
# ==========================================


# ==========================================
# 1. Python
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
__pypackages__/

# Python build
build/
dist/
*.egg-info/
.eggs/
*.egg
.installed.cfg

# Python testing & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/


# ==========================================
# 2. React / TypeScript / Vite / pnpm
# ==========================================

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/

# Vite cache
.vite/

# TypeScript
*.tsbuildinfo

# Linter cache
.eslintcache
.oxlintcache

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager cache
.pnpm-store/


# ==========================================
# 3. Environment Variables & Secrets
# ==========================================

.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx

# Cloud credentials
credentials.json
service-account*.json


# ==========================================
# 4. AI / ML Models
# ==========================================

# Model weights
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
*.h5
*.hdf5

# Model checkpoints
checkpoints/
model_weights/

# ML cache
.cache/
.huggingface/
wandb/
mlruns/
lightning_logs/
tensorboard/

# Training logs
events.out.tfevents.*


# ==========================================
# 5. SpeakSpot Runtime Data
# ==========================================

# Uploaded documents and audio
backend/uploads/
backend/storage/
data/raw/

# Temporary processing files
tmp/
temp/
*.tmp

# Generated output
outputs/

# Local databases
*.db
*.sqlite
*.sqlite3

# Keep experiment source code and results
# experiments/ is intentionally NOT ignored


# ==========================================
# 6. Logs
# ==========================================

*.log
logs/
pip-log.txt


# ==========================================
# 7. IDE / Editor
# ==========================================

# VS Code
.vscode/

# JetBrains
.idea/

# Temporary editor files
*.swp
*.swo
*~
tempCodeRunnerFile.py


# ==========================================
# 8. OS
# ==========================================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble

# Linux
.directory


# ==========================================
# 9. Local Configuration
# ==========================================

.python-version
.streamlit/secrets.toml


# ==========================================
# 10. Project Files to Track
# ==========================================

# The following should be committed:
#
# frontend/src/
# frontend/package.json
# frontend/pnpm-lock.yaml
# backend/app/
# backend/requirements.txt
# docs/
# experiments/
# datasets/ (small evaluation datasets)
# README.md
# .env.example
