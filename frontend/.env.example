# SpeakSpot frontend 환경변수 예시
# 사용하려면 이 파일을 복사해 .env.development.local 로 저장하세요. (.env.* 파일은 git 에 올라가지 않습니다)
# 아무 파일이 없어도 기본값으로 동작합니다.

# API 모드 — 기본: pnpm dev 는 mock, pnpm build 는 server
#   mock   : 백엔드 없이 프론트 내장 Mock API 사용 (docs/contracts.md §7)
#   legacy : backend 초안 API (/api/mock/blocks, /api/search) 사용 — /api/v1 완성 전 연동 테스트용
#   server : backend /api/v1 사용 (contracts.md §3, §4)
VITE_API_MODE=mock

# 개발 도구 표시 (STT 소스 선택, 블록 경계 표시) — 기본: pnpm dev 는 true, pnpm build 는 false
# 개발 중에 실제 사용자 화면을 보려면 false
VITE_DEV_TOOLS=true

# 백엔드 주소 — 기본: 같은 주소 + Vite 프록시(/api → http://127.0.0.1:8000)
# VITE_API_ORIGIN=http://127.0.0.1:8000
